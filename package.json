{
  "name": "mono-commerce-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx server/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "test:benchmark": "playwright test --config playwright.benchmark.config.ts",
    "test:benchmark-report": "node scripts/build-benchmark-review.mjs",
    "test:layout-report": "node scripts/build-layout-review.mjs",
    "test:report": "node scripts/build-report.mjs",
    "check": "tsc -b"
  },
  "dependencies": {
    "@cyberbiz-corp/pitaya-ui": "0.45.1",
    "@fontsource/noto-sans-tc": "5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "lucide-react": "1.42.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "5.3.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
