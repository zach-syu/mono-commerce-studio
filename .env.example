# Frontend (public configuration only). Empty uses the local /api proxy.
VITE_API_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_DISABLED=1

# Backend only. Never prefix a model key or access code with VITE_.
# Default provider: vertex. Explicit supported fallback: gemini-api.
MONO_GOOGLE_PROVIDER=vertex
MONO_LIVE_ACCESS_CODE=
MONO_ALLOWED_ORIGINS=http://127.0.0.1:5173
MONO_DAILY_REQUEST_LIMIT=500
MONO_DAILY_ASSET_BYTES=104857600
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
VERTEX_ACCESS_TOKEN=
MONO_GEMINI_API_KEY=

# Only needed when deploying or testing the Supabase runtime outside Supabase.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Do not put the service role key in a frontend build environment.
